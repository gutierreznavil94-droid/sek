<?xml version="1.0" encoding="utf-8"?>
<!-- Widget chico (2×1) sobre la tormenta: arriba día y racha; abajo los pilares y «Tareas». -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wc_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_fondo_tormenta"
    android:clipToOutline="true">

    <include layout="@layout/widget_tormenta" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_marco"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/wc_dia"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:adjustViewBounds="true"
                android:contentDescription="Día del ciclo"
                android:scaleType="fitStart"
                android:src="@drawable/widget_ej_titulo" />

            <TextView
                android:id="@+id/wc_racha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:text="炎 0"
                android:textColor="#E8304A"
                android:textSize="14sp"
                android:textStyle="bold"
                android:shadowColor="#E6000000"
                android:shadowDy="1"
                android:shadowRadius="4" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/wc_puntos"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="○  ○  ○  ○"
                android:textColor="#F1EBDF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:shadowColor="#E6000000"
                android:shadowDy="1"
                android:shadowRadius="4" />

            <TextView
                android:id="@+id/wc_tareas"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/widget_boton_tareas"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Tareas"
                android:textColor="#F1EBDF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
