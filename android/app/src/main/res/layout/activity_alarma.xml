<?xml version="1.0" encoding="utf-8"?>
<!-- Alarma sonando a pantalla completa: la tormenta de Hoy, la hora grande, el aviso y dos botones. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121110">

    <ImageView
        android:id="@+id/alarma_fondo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/alarma_fondo" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#8C121110" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="56dp"
        android:paddingBottom="40dp">

        <TextView
            android:id="@+id/alarma_hora"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="20:50"
            android:textColor="#F3EFE6"
            android:textSize="76sp"
            android:fontFeatureSettings="tnum"
            android:shadowColor="#D9C8102E"
            android:shadowDx="4"
            android:shadowDy="4"
            android:shadowRadius="1" />

        <ImageView
            android:id="@+id/alarma_titulo"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="12dp"
            android:adjustViewBounds="true"
            android:contentDescription="Alarma"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/alarma_cuerpo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.15"
            android:textColor="#E6F3EFE6"
            android:textSize="18sp"
            android:shadowColor="#E6000000"
            android:shadowDy="1"
            android:shadowRadius="4" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/alarma_posponer"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/alarma_boton_posponer"
            android:gravity="center"
            android:text="Posponer 5 min"
            android:textColor="#F3EFE6"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/alarma_apagar"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/alarma_boton_apagar"
            android:gravity="center"
            android:text="Apagar"
            android:textColor="#F3EFE6"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
