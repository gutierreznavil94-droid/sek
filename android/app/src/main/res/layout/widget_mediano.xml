<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_fondo"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/wm_cabeza"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/wm_titulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="Día 1 de 90"
            android:textColor="#121110"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/wm_racha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔥 0"
            android:textColor="#C8102E"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.4"
            android:orientation="vertical">

            <TextView
                android:id="@+id/wm_vacio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Abrí SEK para ver tus pilares"
                android:textColor="#6B655C"
                android:textSize="13sp"
                android:visibility="gone" />

        <LinearLayout
            android:id="@+id/wm_fila0"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/wm_tilde0"
                android:layout_width="22dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="○"
                android:textColor="#6B655C"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/wm_nombre0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#121110"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/wm_fila1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/wm_tilde1"
                android:layout_width="22dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="○"
                android:textColor="#6B655C"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/wm_nombre1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#121110"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/wm_fila2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/wm_tilde2"
                android:layout_width="22dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="○"
                android:textColor="#6B655C"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/wm_nombre2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#121110"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/wm_fila3"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/wm_tilde3"
                android:layout_width="22dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="○"
                android:textColor="#6B655C"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/wm_nombre3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#121110"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/wm_fila4"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/wm_tilde4"
                android:layout_width="22dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="○"
                android:textColor="#6B655C"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/wm_nombre4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#121110"
                android:textSize="13sp" />
        </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/wm_agua"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="0 / 2 L"
                android:textColor="#121110"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/wm_vaso"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/widget_boton"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="+1 vaso"
                android:textColor="#F1EBDF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/wm_franja"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#6B655C"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
